VITE_API_URL=http://localhost:4000
VITE_API_MODE=backend
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy projects can use this instead of VITE_SUPABASE_PUBLISHABLE_KEY:
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY are accepted only as compatibility aliases.

# Use "backend" for local Express AI routes.
# Use "supabase-edge" after deploying Supabase Edge Functions.
VITE_AI_API_MODE=backend
