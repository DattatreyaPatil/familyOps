PORT=4000
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DATA_STORE=supabase

# If these are present, backend /api routes require a valid Supabase JWT.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy projects can use this instead of SUPABASE_PUBLISHABLE_KEY:
# SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Legacy projects can use this instead of SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PROJECT_REF=your-project-ref
REQUIRE_AUTH=true

# Future DB-backed production implementation.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Gemini is used only from the backend for fridge and receipt image analysis.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
