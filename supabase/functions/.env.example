GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional. Needed for automatic Instagram and TikTok video analysis.
# Deploy services/media-extractor, then use its full /analyze URL and shared secret.
MEDIA_EXTRACTOR_URL=https://your-private-extractor.example/analyze
MEDIA_EXTRACTOR_API_KEY=your-media-extractor-key
